REACT_APP_API_http=https://{apiid}.execute-api.{region}.amazonaws.com/prod
REACT_APP_API_socket=wss://{apiid}.execute-api.{region}.amazonaws.com/Prod
REACT_APP_DEFAULT_UPLOAD_BUCKET=

# OAuth 2.0 / OIDC Configuration for AWS Cognito
REACT_APP_OIDC_ISSUER=https://cognito-idp.{region}.amazonaws.com/{user_pool_id}
REACT_APP_OIDC_CLIENT_ID={your_cognito_client_id}
REACT_APP_OIDC_CLIENT_SECRET={your_cognito_client_secret}
REACT_APP_OIDC_REDIRECT_URI=http://localhost:3000/oauth/callback
REACT_APP_OIDC_AUTHORIZATION_ENDPOINT=https://{cognito_domain}.auth.{region}.amazoncognito.com/oauth2/authorize
REACT_APP_OIDC_TOKEN_ENDPOINT=https://{cognito_domain}.auth.{region}.amazoncognito.com/oauth2/token
REACT_APP_OIDC_JWKS_URI=https://cognito-idp.{region}.amazonaws.com/{user_pool_id}/.well-known/jwks.json
REACT_APP_OIDC_USERINFO_ENDPOINT=https://{cognito_domain}.auth.{region}.amazoncognito.com/oauth2/userInfo